# Entorno de desarrollo / despliegue para Palacio del Mar
# Copia este archivo como .env y define tus credenciales locales (nunca subas .env a Git)

# Claves criptográficas seguras (Genera con: openssl rand -base64 32)
# Nota: La aplicación rechaza valores genéricos o de ejemplo conocidos.
JWT_SECRET=genera_un_secreto_aleatorio_minimo_32_caracteres_con_openssl
PAYMENTS_WEBHOOK_SECRET=genera_un_secreto_webhook_aleatorio_minimo_32_caracteres
PALACIO_PROXY_TOKEN=genera_un_token_aleatorio_para_comunicacion_interna_nginx

# Control de siembra de datos de prueba (por defecto false en producción)
SEED_DEMO_DATA=false
# Si deseas que se cree el usuario administrador inicial, define una contraseña segura:
# ADMIN_DEFAULT_PASSWORD=UnaContrasenaMuySegura2026!

PAYMENTS_SIMULATION_DELAY_SECONDS=2

# URL pública o local para los enlaces enviados en los correos (verificación, pago, voucher)
# - En local: http://localhost:4200
# - Con túnel gratuito para abrir enlaces desde celular u otras redes:
#   Ejecuta `cloudflared tunnel --url http://localhost:4200` y pega aquí la URL https://xxxx.trycloudflare.com
APP_BASE_URL=http://localhost:4200

# Configuración de Correo SMTP Real (Gmail por defecto; compatible con Brevo/SendGrid cambiando host/credenciales)
# 1. Activa la Verificación en 2 pasos en tu cuenta de Google.
# 2. Crea una Contraseña de aplicación de 16 letras (escríbela SIN espacios en SPRING_MAIL_PASSWORD).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=palaciodelmar39@gmail.com
SPRING_MAIL_PASSWORD=abcdefghijklmnop
SPRING_MAIL_FROM=palaciodelmar39@gmail.com
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
SPRING_MAIL_STARTTLS_REQUIRED=true
