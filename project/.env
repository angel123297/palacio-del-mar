# ============================================
# Palacio del Mar — variables para Docker Compose
#
# Este archivo SÍ está versionado a propósito (ver .gitignore) para que
# "docker compose up" funcione con ese único comando, tal como pide la
# actividad de aula. Las credenciales de abajo son de un solo uso, se
# generaron solo para esta entrega y no protegen nada real: NO las
# reutilices en ningún otro proyecto ni las trates como secretas.
#
# Para un despliegue real, borra este archivo, copia .env.example como
# .env y rellena tus propios valores únicos (ver ese archivo).
# ============================================

# Puerto del PC/servidor donde se abre la web (http://localhost:8080).
WEB_PORT=8080

# --- MongoDB ---
MONGO_USER=palacio_admin
MONGO_DB=palacio_del_mar
MONGO_PASSWORD=mBlvNDyMTghessvBEScl

# --- Backend ---
JWT_SECRET=3fd0a31bdb393f7a457959b238ac789483456c3e5a8c61ab8d2f2285fffe5ea4
JWT_EXPIRES_IN=7d

# URL pública desde la que se abre la web (para CORS).
FRONTEND_URL=http://localhost:8080

# Opcional: chat con IA. Sin ninguna clave el chat responde en modo offline
# (respuestas predefinidas), así que se deja vacío para esta entrega.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: envío real de correos. Sin esto, el proyecto funciona igual;
# los correos (verificación, recuperación, confirmación) solo quedan
# registrados en los logs del contenedor backend en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp que se muestra al huésped para confirmar el pago de su reserva
HOTEL_WHATSAPP=+57 300 000 0000

# Zona horaria del hotel: define qué es "hoy" y los límites de cada noche
HOTEL_TIMEZONE=America/Bogota

# --- Administrador inicial ---
# El backend crea esta cuenta como admin automáticamente al arrancar, si
# todavía no existe ningún administrador (ver backend/bootstrap.js).
# También la usa, aparte, el perfil manual:
#   docker compose --profile create-admin run --rm create-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@palaciomar.co
ADMIN_PASSWORD=AulaDocker2026Segura
