# ============================================
# Palacio del Mar - variables para Docker Compose
# 1) Copia este archivo:   cp .env.example .env
# 2) OBLIGATORIO: rellena MONGO_PASSWORD, JWT_SECRET y ADMIN_PASSWORD con
#    valores propios y únicos. Están vacíos a propósito: docker compose no
#    arranca hasta que los definas. Nunca compartas ni subas tu .env.
#    Generar un valor:   openssl rand -hex 32
# ============================================

# Puerto del PC/servidor donde se abre la web (http://localhost:8080).
# En un VPS con dominio normalmente se usa 80.
WEB_PORT=8080

# --- MongoDB ---
MONGO_USER=palacio_admin
MONGO_DB=palacio_del_mar
# Usa solo letras y números (evita @ : / ? # % que rompen la URL de conexión).
MONGO_PASSWORD=

# --- Backend ---
# Cadena larga y aleatoria (solo letras y números, 32+ caracteres).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL pública desde la que se abre la web (para CORS).
# En producción: https://tudominio.com
FRONTEND_URL=http://localhost:8080

# Opcional: chat con IA. Sin ninguna clave el chat responde en modo offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: envío real de correos (verificación, recuperación de
# contraseña, confirmación de reserva). Sin esto, el proyecto funciona
# igual, solo que no se envían los correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp que se muestra al huésped para confirmar el pago de su reserva
HOTEL_WHATSAPP=+57 300 000 0000

# Zona horaria del hotel: define qué es "hoy" y los límites de cada noche
HOTEL_TIMEZONE=America/Bogota

# --- Administrador inicial ---
# Usados solo por: docker compose --profile create-admin run --rm create-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@palaciomar.co
ADMIN_PASSWORD=

