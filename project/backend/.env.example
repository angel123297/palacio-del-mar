# ============================================
# Palacio del Mar - Backend (.env para desarrollo LOCAL sin Docker)
# Si vas a usar Docker Compose, NO necesitas este archivo: las variables
# se pasan desde el .env de la raíz del proyecto. Este archivo es solo
# para correr "npm run dev" directamente en tu máquina.
# ============================================

PORT=5000
NODE_ENV=development

# Mongo local (sin Docker). Si usas Docker, usa el .env de la raíz.
MONGODB_URI=mongodb://localhost:27017/palacio_del_mar

# OBLIGATORIO. Cadena larga y aleatoria (openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# Opcional: chat con IA. Sin ninguna clave, el chat responde en modo offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: envío real de emails (verificación, recuperación de contraseña,
# confirmación de reserva). Sin esto configurado, el proyecto sigue
# funcionando: simplemente no se envían los correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Palacio del Mar" <reservas@palaciomar.co>

# WhatsApp que se muestra al huésped para confirmar el pago manual
HOTEL_WHATSAPP=+57 300 000 0000

# Usados por "npm run create-admin" (backend/scripts/createAdmin.js)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@palaciomar.co
ADMIN_PASSWORD=
