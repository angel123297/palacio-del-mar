# Evita que Git en Windows convierta a CRLF archivos que Docker/nginx leen en Linux
Dockerfile        text eol=lf
*.conf            text eol=lf
docker-compose.yml text eol=lf
.dockerignore     text eol=lf
.env.example      text eol=lf

# Los scripts de shell deben conservar saltos de línea LF (si no, fallan en bash)
*.sh              text eol=lf
